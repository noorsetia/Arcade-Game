# ==============================================================================
# DEVELOPER ARCADE 4.0 — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV="development"

# MongoDB Atlas Database URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="developer_arcade"

# Firebase Admin SDK Credentials
# Used for server-side verification of client Firebase ID tokens.
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=""

# Client-side Firebase Configuration (Vite)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# CORS & Security
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SESSION_RATE_LIMIT_MAX=60

# Gemini AI API Key (Server-Side Cognitive Game Coach)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Self-referential URL where this applet is hosted
APP_URL="MY_APP_URL"
